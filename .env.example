# Cadena de conexión a PostgreSQL. La API se conecta con el rol `daw_api`,
# cuyos privilegios se limitan al esquema `daw`.
DATABASE_URL=postgresql+psycopg://<usuario>:<password>@<host>:5432/postgres

# Clave interna de Django (firma de cookies, protección CSRF). Genere una
# propia; no reutilice este valor ni lo versione:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=<genere_una_clave_propia>

# Modo de depuración. En producción debe ser false.
DJANGO_DEBUG=true

# Dominios desde los que se admite servir la aplicación. En producción debe
# llevar el dominio del despliegue; con la lista por defecto, Django rechaza
# la petición con un 400.
DJANGO_HOSTS_PERMITIDOS=127.0.0.1,localhost

# Con DJANGO_DEBUG=false la aplicación redirige a HTTPS, marca las cookies
# como Secure y activa HSTS. Esta variable desactiva sólo la redirección, para
# poder comprobar en local una compilación de producción sin certificado. En
# el despliegue debe quedar en true o quitarse.
DJANGO_REDIRIGIR_A_HTTPS=true

# Secreto de firma de los tokens de acceso. Genere uno propio; no reutilice
# este valor ni lo versione:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=<genere_un_secreto_propio>

# Vigencia del token en minutos (RN-06).
JWT_MINUTOS_VIGENCIA=60

# --- Cookie de sesión ------------------------------------------------------
# El token viaja en una cookie httpOnly, no en el almacenamiento del
# navegador: así el JavaScript de la página no puede leerlo y una inyección
# de script no basta para robar la sesión.
#
# COOKIE_SEGURA marca la cookie como `Secure`, que sólo viaja por HTTPS. En
# desarrollo debe quedar en false: sobre http://127.0.0.1 el navegador no la
# enviaría, el login parecería correcto y todo lo demás daría 401. En
# producción tiene que ser true.
COOKIE_SEGURA=false

# 'Lax' basta mientras el frontend se sirva desde el mismo origen que la API
# (el proxy de Vite en desarrollo, o el build servido por Django en
# producción). Sólo si el frontend queda en otro dominio hace falta 'None',
# que además exige COOKIE_SEGURA=true y protección CSRF explícita.
COOKIE_SAMESITE=Lax

# Orígenes admitidos para peticiones cross-origin. Con el proxy de Vite no
# hacen falta, pero se dejan configurados por si el frontend se despliega
# aparte.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Credenciales de la cuenta administradora usada por las pruebas de endpoints.
# La cuenta se crea directamente en la base de datos: el registro por la API
# produce siempre cuentas con rol `cliente` (RN-04).
ADMIN_CORREO=<correo_de_la_cuenta_admin>
ADMIN_CONTRASENA=<contrasena_de_la_cuenta_admin>

# Horario de atención de la barbería (RN-21 a RN-23). Los valores por defecto
# corresponden a lunes-sábado de 9:00 a 19:00, con inicios cada 30 minutos.
# DIAS_LABORABLES usa la numeración de Python: 0 es lunes y 6 es domingo.
ZONA_HORARIA=America/Guayaquil
HORA_APERTURA=9
HORA_CIERRE=19
INTERVALO_MINUTOS=30
DIAS_LABORABLES=0,1,2,3,4,5
