# Cadena de conexión a PostgreSQL. La API se conecta con el rol `daw_api`,
# cuyos privilegios se limitan al esquema `daw`.
DATABASE_URL=postgresql+psycopg://<usuario>:<password>@<host>:5432/postgres

# Secreto de firma de los tokens de acceso. Genere uno propio; no reutilice
# este valor ni lo versione:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=<genere_un_secreto_propio>

# Vigencia del token en minutos (RN-06).
JWT_MINUTOS_VIGENCIA=60

# Credenciales de la cuenta administradora usada por las pruebas de endpoints.
# La cuenta se crea directamente en la base de datos: el registro por la API
# produce siempre cuentas con rol `cliente` (RN-04).
ADMIN_CORREO=<correo_de_la_cuenta_admin>
ADMIN_CONTRASENA=<contrasena_de_la_cuenta_admin>

# Horario de atención de la barbería (RN-21 a RN-23). Los valores por defecto
# corresponden a lunes-sábado de 9:00 a 19:00, con inicios cada 30 minutos.
# DIAS_LABORABLES usa la numeración de Python: 0 es lunes y 6 es domingo.
ZONA_HORARIA=America/Guayaquil
HORA_APERTURA=9
HORA_CIERRE=19
INTERVALO_MINUTOS=30
DIAS_LABORABLES=0,1,2,3,4,5
